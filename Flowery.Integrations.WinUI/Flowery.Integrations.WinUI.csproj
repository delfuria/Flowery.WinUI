<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041</TargetFramework>
    <RootNamespace>Flowery.Integrations.WinUI</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <OutputType>Library</OutputType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateLibraryLayout>true</GenerateLibraryLayout>
    <PackageId>Flowery.Integrations.WinUI</PackageId>
    <Description>External user management integrations for FlowKanban (Teams, Slack, GitHub, OAuth).</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>winui;windows;kanban;integrations</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Flowery.WinUI\Flowery.WinUI.csproj" />
    <ProjectReference Include="..\Flowery.WinUI.Kanban\Flowery.WinUI.Kanban.csproj" />
    <PackageReference Include="Octokit" />
    <PackageReference Include="IdentityModel.OidcClient" />
  </ItemGroup>
</Project>
