<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041</TargetFramework>
    <RootNamespace>Flowery.WinUI.Photos</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <OutputType>WinExe</OutputType>
    <ApplicationTitle>Flowery Photos</ApplicationTitle>
    <ApplicationIcon>..\Flowery.WinUI.Gallery\app_icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefaultLanguage>en-US</DefaultLanguage>
    <NoWarn>$(NoWarn);PRI263</NoWarn>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Flowery.WinUI\Flowery.WinUI.csproj" />
    <PackageReference Include="Microsoft.Graphics.Win2D" />
    <Compile Include="..\Flowery.WinUI.Gallery\NativeWindowPlacement.cs" Link="NativeWindowPlacement.cs" />
    <Compile Include="..\Flowery.WinUI.Gallery\ExecutableIcon.cs" Link="ExecutableIcon.cs" />
    <EmbeddedResource Include="Localization\*.json" LogicalName="$(AssemblyName).Localization.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Flowery.WinUI.Gallery.Core\Assets\Fonts\*.ttf;..\Flowery.WinUI.Gallery.Core\Assets\Fonts\*.otf">
      <Link>Assets\Fonts\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\Flowery.WinUI.Gallery.Core\Assets\wallpaper_*.jpg;..\Flowery.WinUI.Gallery.Core\Assets\tile_*.jpg;..\Flowery.WinUI.Gallery.Core\Assets\placeholder1.jpg">
      <Link>Assets\Samples\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\*.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
