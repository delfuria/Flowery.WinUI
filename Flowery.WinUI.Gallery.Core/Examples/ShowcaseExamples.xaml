<local:ScrollableExamplePage
    x:Class="Flowery.WinUI.Gallery.Examples.ShowcaseExamples"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:daisy="using:Flowery.Controls"
    xmlns:local="using:Flowery.WinUI.Gallery.Examples">

    <local:ScrollableExamplePage.Resources>
        <Style TargetType="local:DaisyButtonTechDemo" BasedOn="{StaticResource DaisyButtonStyle}" />
        <Color x:Key="ShowcaseNeumorphicLightShadowColor">#FFFFFFFF</Color>
        <Color x:Key="ShowcaseNeumorphicDarkShadowColor">#FF0D2750</Color>
        <daisy:DaisyShadowCollection x:Key="ShowcaseRaisedShadows">
            <daisy:DaisyShadow OffsetX="-8" OffsetY="-8" BlurRadius="16"
                        Color="{StaticResource ShowcaseNeumorphicLightShadowColor}" />
            <daisy:DaisyShadow OffsetX="8" OffsetY="8" BlurRadius="16"
                        Color="{StaticResource ShowcaseNeumorphicDarkShadowColor}" />
        </daisy:DaisyShadowCollection>
    </local:ScrollableExamplePage.Resources>

    <ScrollViewer x:Name="MainScrollViewer" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto" IsTabStop="True" Background="Transparent" Padding="0,0,0,32">
        <StackPanel Spacing="16" Margin="24,0,24,32">
            <TextBlock Text="Neumorphic Raised Tech Lab"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource DaisyBaseContentBrush}" />
            <TextBlock Text="Doc-compliant neumorphism first, then raw shadow tech demos for comparison."
                       Opacity="{ThemeResource GalleryOpacity70}"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource DaisyBaseContentBrush}" />

            <TextBlock Text="DaisyButton tech demos"
                       Opacity="{ThemeResource GalleryOpacity70}"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource DaisyBaseContentBrush}" />
            <daisy:WrapPanel Orientation="Horizontal" HorizontalSpacing="16" VerticalSpacing="16">
                <local:DaisyButtonTechDemo Content="E"
                                           MinWidth="50"
                                           Margin="10"
                                           CornerRadius="10"
                                           TechMode="Elevation"
                                           Style="{StaticResource DaisyButtonStyle}" />

                <local:DaisyButtonTechDemo Content="F"
                                           MinWidth="50"
                                           Margin="10"
                                           CornerRadius="10"
                                           TechMode="DropShadow"
                                           Style="{StaticResource DaisyButtonStyle}" />

                <local:DaisyButtonTechDemo Content="G"
                                           MinWidth="50"
                                           Margin="10"
                                           CornerRadius="10"
                                           TechMode="ThemeShadow"
                                           Style="{StaticResource DaisyButtonStyle}" />
            </daisy:WrapPanel>
            <StackPanel Spacing="6">
                <TextBlock Text="Platform expectations"
                           Opacity="{ThemeResource GalleryOpacity70}"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource DaisyBaseContentBrush}" />
                <TextBlock Text="WinUI: E -> projected ThemeShadow, F -> Composition DropShadow, G -> ThemeShadow with an explicit receiver"
                           Opacity="{ThemeResource GalleryOpacity60}"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource DaisyBaseContentBrush}" />
            </StackPanel>

            <TextBlock Text="Doc-compliant (DaisyNeumorphicHelper)"
                       Opacity="{ThemeResource GalleryOpacity70}"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource DaisyBaseContentBrush}" />
            <daisy:WrapPanel Orientation="Horizontal" HorizontalSpacing="16" VerticalSpacing="16">
                <Border Background="{ThemeResource DaisyBase200Brush}" CornerRadius="12" Padding="12" Width="220">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Helper (Global)" Opacity="{ThemeResource GalleryOpacity70}" Foreground="{ThemeResource DaisyBaseContentBrush}" />
                        <daisy:DaisyShadowContainer Shadows="{StaticResource ShowcaseRaisedShadows}"
                                             Background="{ThemeResource DaisyBase200Brush}">
                            <Border CornerRadius="10" Padding="12,8" Background="{ThemeResource DaisyBase200Brush}">
                                <TextBlock Text="A"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource GalleryShowcaseForegroundBrush}" />
                            </Border>
                        </daisy:DaisyShadowContainer>
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource DaisyBase200Brush}" CornerRadius="12" Padding="12" Width="220">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Helper (Forced Raised)" Opacity="{ThemeResource GalleryOpacity70}" Foreground="{ThemeResource DaisyBaseContentBrush}" />
                        <daisy:DaisyShadowContainer Shadows="{StaticResource ShowcaseRaisedShadows}"
                                             Background="{ThemeResource DaisyBase200Brush}">
                            <Border CornerRadius="10" Padding="12,8" Background="{ThemeResource DaisyBase200Brush}">
                                <TextBlock Text="B"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource GalleryShowcaseForegroundBrush}" />
                            </Border>
                        </daisy:DaisyShadowContainer>
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource DaisyBase200Brush}" CornerRadius="12" Padding="12" Width="220">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Helper (Raised)" Opacity="{ThemeResource GalleryOpacity70}" Foreground="{ThemeResource DaisyBaseContentBrush}" />
                        <Grid x:Name="DropShadowHost">
                            <daisy:DaisyShadowContainer Shadows="{StaticResource ShowcaseRaisedShadows}"
                                                 Background="{ThemeResource DaisyBase200Brush}">
                                <Border CornerRadius="10" Padding="12,8" Background="{ThemeResource DaisyBase200Brush}">
                                    <TextBlock Text="C"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource GalleryShowcaseForegroundBrush}" />
                                </Border>
                            </daisy:DaisyShadowContainer>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource DaisyBase200Brush}" CornerRadius="12" Padding="12" Width="220">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Helper (Raised)" Opacity="{ThemeResource GalleryOpacity70}" Foreground="{ThemeResource DaisyBaseContentBrush}" />
                        <Grid x:Name="ThemeShadowHost">
                            <daisy:DaisyShadowContainer Shadows="{StaticResource ShowcaseRaisedShadows}"
                                                 Background="{ThemeResource DaisyBase200Brush}">
                                <Border CornerRadius="10" Padding="12,8" Background="{ThemeResource DaisyBase200Brush}">
                                    <TextBlock Text="D"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource GalleryShowcaseForegroundBrush}" />
                                </Border>
                            </daisy:DaisyShadowContainer>
                        </Grid>
                    </StackPanel>
                </Border>
            </daisy:WrapPanel>

            <TextBlock Text="Raw shadow tech demos (not doc-compliant)"
                       Opacity="{ThemeResource GalleryOpacity70}"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource DaisyBaseContentBrush}" />
            <daisy:WrapPanel Orientation="Horizontal" HorizontalSpacing="16" VerticalSpacing="16">
                <Border Background="{ThemeResource DaisyBase200Brush}" CornerRadius="12" Padding="12" Width="220">
                    <StackPanel Spacing="8">
                        <TextBlock Text="WinUI projected ThemeShadow" Opacity="{ThemeResource GalleryOpacity70}" Foreground="{ThemeResource DaisyBaseContentBrush}" />
                        <Border x:Name="RawElevationTarget"
                                MinWidth="140"
                                CornerRadius="10"
                                Padding="12,8"
                                Background="{ThemeResource DaisyBase200Brush}">
                            <TextBlock Text="S"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource GalleryShowcaseForegroundBrush}" />
                        </Border>
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource DaisyBase200Brush}" CornerRadius="12" Padding="12" Width="220">
                    <StackPanel Spacing="8">
                        <TextBlock Text="WinUI dual shadow container" Opacity="{ThemeResource GalleryOpacity70}" Foreground="{ThemeResource DaisyBaseContentBrush}" />
                        <daisy:DaisyShadowContainer Shadows="{StaticResource ShowcaseRaisedShadows}"
                                             Background="{ThemeResource DaisyBase200Brush}"
                                             CornerRadius="10"
                                             MinWidth="140"
                                             Padding="12,8">
                            <StackPanel Spacing="8">
                                <TextBlock Text="WinUI + Composition"
                                           Foreground="{ThemeResource DaisyBaseContentBrush}" />
                                <daisy:DaisyInput Text="Composition"
                                                  AutomationProperties.AutomationId="CompositionFoundationInput"
                                                  AutomationProperties.Name="Composition" />
                            </StackPanel>
                        </daisy:DaisyShadowContainer>
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource DaisyBase200Brush}" CornerRadius="12" Padding="12" Width="220">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Windows DropShadow (SpriteVisual)" Opacity="{ThemeResource GalleryOpacity70}" Foreground="{ThemeResource DaisyBaseContentBrush}" />
                        <Grid x:Name="RawDropShadowHost">
                            <Canvas x:Name="RawDropShadowLayer" IsHitTestVisible="False" />
                            <Border x:Name="RawDropShadowTarget"
                                    MinWidth="140"
                                    CornerRadius="10"
                                    Padding="12,8"
                                    Background="{ThemeResource DaisyBase200Brush}">
                                <TextBlock Text="W"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource GalleryShowcaseForegroundBrush}" />
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

            </daisy:WrapPanel>
        </StackPanel>
    </ScrollViewer>
</local:ScrollableExamplePage>
