<Project>
  <PropertyGroup Condition="'$(UseWinUI)' == 'true' and '$(IsPackable)' == 'true'">
    <DisableEmbeddedXbf>false</DisableEmbeddedXbf>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseWinUI)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)GlobalUsings.cs" Link="GlobalUsings.cs" Condition="'$(MSBuildProjectName)' != 'Flowery.WinUI.Kanban'" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" PrivateAssets="all" />
  </ItemGroup>
</Project>
